# ============================================================
# SegmentHub - Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# O .env é lido automaticamente via python-dotenv.

# ============================================================
# MODO DE EXECUÇÃO
# ============================================================
# "local"     = Usa SQLite fake (sem Databricks)
# "production" = Usa Databricks SQL Warehouse (default)
ENV=local

# ============================================================
# DATABRICKS (apenas para ENV=production)
# ============================================================
# Host do workspace (sem https://)
# DATABRICKS_HOST=adb-xxxx.azuredatabricks.net

# ID do SQL Warehouse
# DATABRICKS_WAREHOUSE_ID=abc123def456

# Token de acesso (ou use OAuth via databricks-sdk Config())
# DATABRICKS_TOKEN=dapi...

# ============================================================
# UNITY CATALOG
# ============================================================
UC_CATALOG=plataforma
UC_SCHEMA=default

# ============================================================
# APP CONFIG
# ============================================================
LOG_LEVEL=INFO
QUERY_TIMEOUT_SECONDS=120
POLL_INTERVAL_SECONDS=2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1
RETRY_BACKOFF_FACTOR=2

# ============================================================
# JOBS (apenas para ENV=production)
# ============================================================
# Path do notebook de execução no workspace
# SEG_EXEC_NOTEBOOK_PATH=/Workspace/Users/.../seg_exec
